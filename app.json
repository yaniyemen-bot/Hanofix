{
  "expo": {
    "name": "Hanofix",
    "slug": "agon-preview",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yaniyemen.hanofix"
    },
    "android": {
      "package": "com.yaniyemen.hanofix",
      "versionCode": 5,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "userInterfaceStyle": "light"
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "eas": {
        "projectId": "28667ca8-c5a0-45fd-811e-c66d4bae9ae3"
      }
    },
    "updates": {},
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "yaniyemen",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-font"
    ]
  }
}
